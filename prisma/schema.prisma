datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  password      String // hashed password
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  projects      Project[]
  activityLogs  ActivityLog[]
  templates     Template[]
}

model Project {
  id              String           @id @default(cuid())
  name            String
  description     String?
  config          Json // The metadata-driven page configuration
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions     FormSubmission[]
  errorLogs       ErrorLog[]
  apiRequests     ApiRequest[]
  isDeleted       Boolean          @default(false) // Soft delete support

  @@index([userId])
}

model FormSubmission {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  data        Json // Submitter's dynamic form data payload
  submittedAt DateTime @default(now())

  @@index([projectId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // E.g., "CREATE_PROJECT", "UPDATE_CONFIG", "IMPORT_CSV"
  details   String?
  timestamp DateTime @default(now())

  @@index([userId])
}

model ErrorLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message   String
  severity  String // "info" | "warning" | "error" | "critical"
  stack     String?
  timestamp DateTime @default(now())

  @@index([projectId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  category    String // E.g., "CRM", "HR", "Analytics"
  description String
  config      Json // The template config structure
  popularity  Int      @default(0)
  createdAt   DateTime @default(now())
  userId      String? // Null for default global templates
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ApiRequest {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoint   String
  method     String // "GET" | "POST" | "PUT" | "DELETE"
  status     Int // HTTP status code
  durationMs Int // Execution duration
  timestamp  DateTime @default(now())

  @@index([projectId])
}
